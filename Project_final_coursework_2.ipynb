   "cell_type": "code",
   "execution_count": 22,
   "id": "137a884f-ac46-4ab8-bf80-2a23673ea9c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluation (Gradient Boosting)\n",
    "mse_gb = mean_squared_error(y_test, y_pred_gb)  \n",
    "r2_gb = r2_score(y_test, y_pred_gb)  \n",
    "n_gb = X_test.shape[0]  \n",
    "p_gb = X_test.shape[1]  \n",
    "r2_adj_gb = 1 - (1 - r2_gb) * (n_gb - 1) / (n_gb - p_gb - 1)  \n",
    "mae_gb = mean_absolute_error(y_test, y_pred_gb)  \n",
    "cv_scores_gb = cross_val_score(gb_model, X_train_scaled, y_train, cv=5)  \n",
    "\n",
    "# Evaluation ( Random Forest )\n",
