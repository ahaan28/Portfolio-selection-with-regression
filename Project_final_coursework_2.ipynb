    "# Define the date range\n",
    "start_date = \"2022-12-01\"\n",
    "end_date = \"2024-12-01\"\n",
    "\n",
    "# Create  DataFrame for storing\n",
    "closing_prices = pd.DataFrame()\n",
    "\n",
    "# Download for each ticker and handle API for each ticker if not downloaded\n",
    "for ticker in tickers:\n",
    "    try:\n",
    "        print(f\"Downloading data for {ticker}...\")\n",
    "        stock_data = yf.download(ticker, start=start_date, end=end_date, interval=\"1d\")\n",
    "        if not stock_data.empty:\n",
    "            closing_prices[ticker] = stock_data[\"Close\"]\n",
    "    except Exception as e:\n",
    "        print(f\"Failed to download data for {ticker}: {e}\")\n",
    "\n",
    "# dates as the index\n",
    "closing_prices.index.name = \"Date\"\n",
    "current_dir = os.getcwd()\n",
    "\n",
    "# output path to store the CSV file in the script's directory\n",
    "output_path = os.path.join(current_dir, \"all_stock_data.csv\") #This will save the data in the same folder as the notebook\n",
    "\n",
    "# closing prices to a CSV file\n",
    "try:\n",
    "    closing_prices.to_csv(output_path)\n",
    "    print(f\"Closing prices with dates have been saved to '{output_path}'.\")\n",
    "except PermissionError:\n",
    "    print(f\"Permission error: Unable to save file to '{output_path}'.\")\n",
    "except OSError as e:\n",
    "    print(f\"OS error: {e}\")"
   ]
